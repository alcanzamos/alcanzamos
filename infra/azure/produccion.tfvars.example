# Producción, en la suscripción de pago por uso (D-200 (7)). Copia como produccion.tfvars; nunca se sube al repositorio.
# Uso: tofu plan -var-file=produccion.tfvars (el estado y el backend, en el README).
ambiente                 = "produccion"
subscription_id          = "00000000-0000-0000-0000-000000000000"
dominio_de_correo        = "avisos.alcanzamos.co"
correo_remitente         = "no-responder@avisos.alcanzamos.co"
imagen_api               = "ghcr.io/alcanzamos/alcanzamos-api@sha256:<digest>" # solo por digest: el probado en UAT; la pasa el pipeline
ghcr_usuario             = "<usuario de GitHub dueño del token read:packages>"
# ghcr_nombre_del_secreto = "ghcr-lectura" (por defecto): el secreto del Key Vault con ese token (README).
# correo_usuario = "emailapikey" y correo_nombre_del_secreto = "correo-contrasena" (por defecto): la contraseña de SMTP de Zoho CPaaS la carga el dueño en el Key Vault (README, «Correo por Zoho CPaaS»).
# red_espacio_de_direcciones = "10.60.0.0/24" (por defecto): una /24 privada; de ahí salen la /27 del entorno y la /28 de PostgreSQL. UAT y producción no se emparejan.
# alerta_umbral, alerta_ventana y alerta_correo tienen los valores de O-5 (D-120).
# Los tamaños (postgres_sku, postgres_almacenamiento_mb, registros_dias_de_retencion, secretos_dias_de_retencion,
# api_replicas_minimas, contenedor_cpu y contenedor_memoria) tienen por defecto los de producción (ADR-006 §5.2).
