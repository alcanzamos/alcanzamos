{
  "name": "alcanzamos-movil",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "engines": {
    "node": ">=24.22.1",
    "npm": "12.2.1"
  },
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --android --lan",
    "tokens": "style-dictionary build --config ../diseno/style-dictionary.config.mjs",
    "textos": "node ../diseno/generar-textos.mjs android src/textos/es.generated.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "auditoria": "node scripts/auditoria.mjs",
    "licencias": "node scripts/licencias.mjs",
    "antiguedad": "node scripts/antiguedad.mjs",
    "export:android": "expo export --platform android",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "comprobar-bundle": "node scripts/comprobar-bundle.mjs",
    "integracion:api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/integracion-api.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.19",
    "expo-font": "58.0.10",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "style-dictionary": "5.7.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/tests"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/ayudas/preparar.ts"
    ],
    "reporters": [
      [
        "default",
        {
          "summaryThreshold": 0
        }
      ]
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.{ts,tsx}"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/tokens/**",
      "scripts/*-logica.mjs"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 50
      }
    },
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "babelrc": false,
          "configFile": false,
          "presets": [
            "babel-preset-expo"
          ],
          "caller": {
            "name": "metro",
            "bundler": "jest",
            "platform": "ios"
          }
        }
      ]
    }
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
