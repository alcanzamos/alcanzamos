{
  "name": "alcanzamos-movil",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --android --lan",
    "tokens": "style-dictionary build --config ../diseno/style-dictionary.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "auditoria": "node scripts/auditoria.mjs",
    "licencias": "node scripts/licencias.mjs",
    "export:android": "expo export --platform android",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "comprobar-bundle": "node scripts/comprobar-bundle.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "57.0.31",
    "expo-font": "57.0.4",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-expo": "57.0.6",
    "style-dictionary": "5.7.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.{ts,tsx}"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/tokens/**",
      "scripts/*-logica.mjs"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 50
      }
    },
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "babelrc": false,
          "configFile": false,
          "presets": [
            "babel-preset-expo"
          ],
          "caller": {
            "name": "metro",
            "bundler": "jest",
            "platform": "ios"
          }
        }
      ]
    }
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  }
}
