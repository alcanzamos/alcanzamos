# Instalación endurecida (ver «Instalación de dependencias» en el README de esta carpeta y la decisión del PR).
# Este archivo se aplica igual en local, en los pipelines y en el Dockerfile: nadie debe repetir estas opciones en la línea de comandos.

# Una dependencia con scripts de instalación que no esté revisada en allowScripts (package.json) hace fallar la instalación.
strict-allow-scripts=true

# No se instala ninguna versión publicada hace menos de 7 días: da tiempo a que se detecten paquetes publicados con malware.
# Solo se exceptúa con min-release-age-exclude[]=paquete y una justificación fechada en el README (correcciones de seguridad urgentes).
min-release-age=7

# Sin dependencias desde repositorios git ni desde URL remotas: todo viene del registro y queda en el lockfile con integridad.
allow-git=none
allow-remote=none

# La versión de Node y de npm de engines es obligatoria, no una advertencia.
engine-strict=true
